# Runtime paths
WORKSPACE_DIR=/workspace
COMFY_DIR=/workspace/ComfyUI
FANVUE_DIR=/workspace/fanvue
BUNDLE_DIR=/workspace/fanvue/bootstrap
OUTPUT_DIR=/workspace/fanvue/output
INPUT_DIR=/workspace/fanvue/input

# Bootstrap behavior
FANVUE_PREFLIGHT_MODE=real
FANVUE_FIRST_TEST_ONLY=true
FANVUE_DOWNLOAD_DRY_RUN=false
FANVUE_NODE_INSTALL_DRY_RUN=false
COMFYUI_PORT=8188

# Optional. Used by n8n/RunPod layer, not by this repo directly yet.
FANVUE_JOB_ID=
FANVUE_CHARACTER_ID=
FANVUE_JOB_TYPE=photo
FANVUE_JOB_FILE=
FANVUE_JOB_JSON=
FANVUE_JOB_JSON_BASE64=

# Optional local-only direct RunPod testing.
# Never commit a real value.
RUNPOD_API_KEY=
RUNPOD_REST_BASE_URL=https://rest.runpod.io/v1
RUNPOD_IMAGE_NAME=ghcr.io/leo-aiteam/fanvue-comfy-runtime:latest
RUNPOD_GPU_TYPE=NVIDIA L40S
RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_VOLUME_GB=0

# Optional runtime-side worker. This reduces n8n executions by moving
# ComfyUI wait/submit/history/download into the pod.
FANVUE_AUTO_RUN_PROMPT=false
FANVUE_WORKER_DRY_RUN=false
FANVUE_WORKER_FETCH_RETRIES=3
FANVUE_WORKER_FETCH_RETRY_DELAY_MS=5000
FANVUE_API_PROMPT=api_prompts/flux2_klein_4b_smoke.json
FANVUE_API_PROMPT_TEMPLATE=api_prompts/face_detailer_smoke_template.json
FANVUE_INPUT_IMAGE_PATH=
FANVUE_INPUT_IMAGE_NAME=
FANVUE_INPUT_SUBFOLDER=fanvue/runtime
FANVUE_FILENAME_PREFIX=fanvue_runtime_output
FANVUE_CALLBACK_URL=
FANVUE_CALLBACK_DRY_RUN=false
FANVUE_CALLBACK_FAILS_JOB=false
FANVUE_CALLBACK_RETRIES=3
FANVUE_CALLBACK_RETRY_DELAY_MS=5000
FANVUE_CALLBACK_AUTH_HEADER=
FANVUE_CALLBACK_AUTH_VALUE=

# Optional direct Supabase access for no-n8n queue tests.
# Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
