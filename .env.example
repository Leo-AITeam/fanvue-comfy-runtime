# Runtime paths
WORKSPACE_DIR=/workspace
COMFY_DIR=/workspace/ComfyUI
FANVUE_DIR=/workspace/fanvue
BUNDLE_DIR=/workspace/fanvue/bootstrap
OUTPUT_DIR=/workspace/fanvue/output
INPUT_DIR=/workspace/fanvue/input

# Bootstrap behavior
FANVUE_PREFLIGHT_MODE=real
FANVUE_FIRST_TEST_ONLY=true
FANVUE_DOWNLOAD_DRY_RUN=false
FANVUE_NODE_INSTALL_DRY_RUN=false
COMFYUI_PORT=8188

# Optional. Used by n8n/RunPod layer, not by this repo directly yet.
FANVUE_JOB_ID=
FANVUE_CHARACTER_ID=
FANVUE_JOB_TYPE=photo

# Optional local-only direct RunPod testing.
# Never commit a real value.
RUNPOD_API_KEY=
RUNPOD_REST_BASE_URL=https://rest.runpod.io/v1
RUNPOD_IMAGE_NAME=ghcr.io/leo-aiteam/fanvue-comfy-runtime:latest
RUNPOD_GPU_TYPE=NVIDIA L40S
RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_VOLUME_GB=0
